# SmartAMP - Custom ESP32 WROVER (4MB) + TAS5805M DAC/AMP
# Reuses the esparagus-audio-brick board code (TAS58xx driver auto-detects TAS5805M)
CONFIG_BOARD_ESPARAGUS_LOUDER=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="components/boards/partitions-4m.csv"
CONFIG_DAC_TAS58XX=y
CONFIG_DAC_CONTROLS_VOLUME=y

# GPIO config
CONFIG_I2S_BCK_IO=13
CONFIG_I2S_WS_IO=33
CONFIG_I2S_DO_IO=27
CONFIG_DAC_I2C_SDA=14
CONFIG_DAC_I2C_SCL=26

# Bluetooth PIN code (overrides sdkconfig.defaults.bt)
CONFIG_BT_PIN_CODE="0000"

