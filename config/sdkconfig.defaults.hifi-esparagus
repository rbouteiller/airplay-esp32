# HiFi-Esparagus defaults (ESP32, PCM5100 — plain I2S DAC, no I2C, no mute pin)
CONFIG_BOARD_HIFI_ESPARAGUS=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

# GPIO config
CONFIG_I2S_BCK_IO=26
CONFIG_I2S_WS_IO=25
CONFIG_I2S_DO_IO=22
CONFIG_LED_RGB_GPIO=33

# The PCM5100A's FLT pin is tied to GND in Sonocotta's schematics (normal
# filter, 22 samples).
CONFIG_DAC_PLAIN_DELAY_PCM510X_NORMAL=y
