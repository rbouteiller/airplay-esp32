# Amped-Esparagus rev M defaults (ESP32, PCM5100 DAC + TPA3110/TPA3128 amp
# — no I2C, active-high UNMUTE pin; rotary encoder for volume + play/pause)
CONFIG_BOARD_AMPED_ESPARAGUS=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

# GPIO config
CONFIG_I2S_BCK_IO=26
CONFIG_I2S_WS_IO=25
CONFIG_I2S_DO_IO=22
CONFIG_DAC_ENABLE_GPIO=13
CONFIG_LED_RGB_GPIO=12

# Rotary encoder (turn = volume, click = play/pause toggle)
CONFIG_BTN_ROTARY_A_GPIO=33
CONFIG_BTN_ROTARY_B_GPIO=27
CONFIG_BTN_PLAY_PAUSE_GPIO=34

# W5500 Ethernet
CONFIG_ETH_W5500_ENABLED=y
CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_W5500=y
CONFIG_SPI_CLK_GPIO=18
CONFIG_SPI_MOSI_GPIO=23
CONFIG_SPI_MISO_GPIO=19
CONFIG_ETH_W5500_CS_GPIO=5
CONFIG_ETH_W5500_INT_GPIO=35
CONFIG_ETH_W5500_RST_GPIO=14

# No display: the board's ILI9342 TFT would need LVGL, and the ESP32 has too
# little internal RAM to spare for it alongside AirPlay and Bluetooth.
