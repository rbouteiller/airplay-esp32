# =============================================================================
# Seeed XIAO ESP32-C5 target defaults
# =============================================================================
# Single-core RISC-V @ 240 MHz, 8 MB flash, 8 MB PSRAM, dual-band Wi-Fi 6,
# Bluetooth 5 LE only (no Bluetooth Classic / A2DP).
CONFIG_BOARD_ESP32C5_XIAO=y

# Flash layout (8 MB)
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

# PSRAM (8 MB, quad SPI)
CONFIG_SPIRAM=y

# Single-core scheduler
CONFIG_FREERTOS_UNICORE=y

# Console over the built-in USB Serial/JTAG (USB-C) for flashing + monitor
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Prefer the 5 GHz band when the network is available on both bands.
CONFIG_WIFI_PREFER_5GHZ=y

# =============================================================================
# GPIO defaults (XIAO ESP32-C5 silkscreen -> chip GPIO)
#   D8/SCK  = GPIO8   -> I2S bit clock (BCK)
#   D10/MOSI = GPIO10   -> I2S word select (WS/LCK)
#   D9/MISO = GPIO9  -> I2S data out (DIN)
#   USER LED (yellow) = GPIO27
#   ADC_BAT = GPIO6
# Wire your external I2S DAC (e.g. PCM5102A) to these pins, or adjust here /
# via `idf.py menuconfig` -> Board Configuration -> Pin Configuration.
CONFIG_LED_STATUS_GPIO=27
CONFIG_I2S_BCK_IO=8
CONFIG_I2S_WS_IO=10
CONFIG_I2S_DO_IO=9
CONFIG_BAT_CHANNEL=6
