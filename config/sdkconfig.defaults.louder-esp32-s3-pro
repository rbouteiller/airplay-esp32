# Louder-ESP32-S3-Pro defaults (ESP32-S3, TAS5825M). Shares the
# Louder-ESP32-S3-Plus pinout and adds a WS2812 on GPIO 21 and a 320x240
# ST7789 TFT on the display header, driven the same way as the Audio Brick
# Dual's -- same SPI pins, backlight on GPIO 42 instead of GPIO 2. The board's
# cooling fan (PWM on GPIO 2, tacho on GPIO 1) is not driven by this firmware;
# GPIO 2 left alone runs the fan continuously.
CONFIG_BOARD_LOUDER_ESP32_S3_PRO=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_SPIRAM_MODE_OCT=y

CONFIG_DAC_TAS58XX=y
CONFIG_DAC_CONTROLS_VOLUME=y

# GPIO config
CONFIG_I2S_SCK_IO=-1
CONFIG_I2S_BCK_IO=14
CONFIG_I2S_WS_IO=15
CONFIG_I2S_DO_IO=16
CONFIG_DAC_I2C_SDA=8
CONFIG_DAC_I2C_SCL=9
CONFIG_DAC_PDN_GPIO=17
CONFIG_LED_RGB_GPIO=21

# W5500 Ethernet
CONFIG_ETH_W5500_ENABLED=y
CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_W5500=y
CONFIG_SPI_CLK_GPIO=12
CONFIG_SPI_MOSI_GPIO=11
CONFIG_SPI_MISO_GPIO=13
CONFIG_ETH_W5500_CS_GPIO=10
CONFIG_ETH_W5500_INT_GPIO=6
CONFIG_ETH_W5500_RST_GPIO=5

# SPI Display
CONFIG_DISPLAY_ENABLED=y
CONFIG_DISPLAY_DRIVER_ST7789=y
CONFIG_DISPLAY_BUS_SPI=y
CONFIG_DISPLAY_SPI_CLK=12
CONFIG_DISPLAY_SPI_MOSI=11
CONFIG_DISPLAY_SPI_MISO=13
CONFIG_DISPLAY_SPI_CS=47
CONFIG_DISPLAY_SPI_DC=38
CONFIG_DISPLAY_SPI_RST=48
CONFIG_DISPLAY_BL_GPIO=42
CONFIG_DISPLAY_ST7789_WIDTH=320
CONFIG_DISPLAY_ST7789_HEIGHT=240
CONFIG_DISPLAY_ST7789_GAP_X=0
CONFIG_DISPLAY_ST7789_GAP_Y=0

# LVGL configuration
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_MEM_SIZE_KILOBYTES=64
CONFIG_LV_USE_LABEL=y
CONFIG_LV_USE_BAR=y
CONFIG_LV_USE_THEME_DEFAULT=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y

# Internal RAM is the limit on this board once display, Ethernet, Wi-Fi,
# AirPlay and (on a uac build) USB audio are all resident. On top of the
# .bss the defaults move to PSRAM, let Wi-Fi and lwIP take their buffers
# from PSRAM. This also makes the Wi-Fi TX buffers static, which on the
# original ESP32 costs more internal RAM than it saves (see
# sdkconfig.defaults.bt), so it is not a default.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
