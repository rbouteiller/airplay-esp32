# Loud-ESP32-S3 defaults (ESP32-S3, dual MAX98357A — I2S amp, active-high
# SD_MODE enable shared by both, no I2C)
CONFIG_BOARD_LOUD_ESP32_S3=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_SPIRAM_MODE_OCT=y

# GPIO config
CONFIG_I2S_SCK_IO=-1
CONFIG_I2S_BCK_IO=14
CONFIG_I2S_WS_IO=15
CONFIG_I2S_DO_IO=16
# Enable pin is GPIO17 on rev G and later hardware; rev F used GPIO8.
CONFIG_DAC_ENABLE_GPIO=17

# W5500 Ethernet
CONFIG_ETH_W5500_ENABLED=y
CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_W5500=y
CONFIG_SPI_CLK_GPIO=12
CONFIG_SPI_MOSI_GPIO=11
CONFIG_SPI_MISO_GPIO=13
CONFIG_ETH_W5500_CS_GPIO=10
CONFIG_ETH_W5500_INT_GPIO=6
CONFIG_ETH_W5500_RST_GPIO=5

# SPI Display
CONFIG_DISPLAY_ENABLED=y
CONFIG_DISPLAY_DRIVER_SH1106=y
CONFIG_DISPLAY_BUS_SPI=y
CONFIG_DISPLAY_SPI_CLK=12
CONFIG_DISPLAY_SPI_MOSI=11
CONFIG_DISPLAY_SPI_CS=39
CONFIG_DISPLAY_SPI_DC=40
CONFIG_DISPLAY_SPI_RST=38
