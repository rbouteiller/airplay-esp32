# Esparagus Audio Brick Dual DAC (rev D) defaults
# ESP32-S3 with two TAS5825M on the same I2S bus: @0x4C stereo satellites,
# @0x4D second amp (PBTL mono sub), roles assigned at runtime by detect order.
CONFIG_BOARD_ESPARAGUS_AUDIO_BRICK_DUAL_DAC=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_SPIRAM_MODE_OCT=y

CONFIG_DAC_TAS58XX=y
CONFIG_DAC_CONTROLS_VOLUME=y

# GPIO config
CONFIG_I2S_SCK_IO=-1
CONFIG_I2S_BCK_IO=14
CONFIG_I2S_WS_IO=15
CONFIG_I2S_DO_IO=16
CONFIG_DAC_I2C_SDA=8
CONFIG_DAC_I2C_SCL=9
# Rev D reuses the single-DAC FAULTZ/PWDN pins as the two DAC enables,
# so no fault line is routed back to the MCU.
CONFIG_DAC_PDN_GPIO=18
CONFIG_DAC_PDN2_GPIO=17
CONFIG_SPKFAULT_GPIO=-1
CONFIG_LED_RGB_GPIO=21

# W5500 Ethernet
CONFIG_ETH_W5500_ENABLED=y
CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_W5500=y
CONFIG_SPI_CLK_GPIO=12
CONFIG_SPI_MOSI_GPIO=11
CONFIG_SPI_MISO_GPIO=13
CONFIG_ETH_W5500_CS_GPIO=10
CONFIG_ETH_W5500_INT_GPIO=6
CONFIG_ETH_W5500_RST_GPIO=5

