# USB Audio Class input (host -> I2S DAC).
#
# The board enumerates on the attached computer as a stereo USB speaker and
# plays the received audio through the same output path AirPlay uses. AirPlay
# is suspended while the host streams and resumes once the stream goes idle.
#
# Layer this on top of a board's own defaults, e.g.
#   -DSDKCONFIG_DEFAULTS="config/sdkconfig.defaults;config/sdkconfig.defaults.<board>;config/sdkconfig.defaults.uac"
#
# Requires a chip with USB OTG (ESP32-S2/S3/P4) and the USB D+/D- pins routed
# to a device-role (CC pulldown) USB connector.

CONFIG_USB_AUDIO_SINK=y
CONFIG_USB_AUDIO_SINK_IDLE_MS=2000

# Stereo speaker only — no microphone endpoint.
CONFIG_UAC_SPEAKER_CHANNEL_NUM=2
CONFIG_UAC_MIC_CHANNEL_NUM=0
CONFIG_UAC_BIT_RESOLUTION_16=y

# Must equal CONFIG_OUTPUT_SAMPLE_RATE_HZ: the UAC descriptor advertises a
# single fixed rate and this path does not resample. AirPlay on the same build
# retunes the I2S clock to its own 44.1 kHz and the sink restores this rate
# when the host resumes, so neither source is converted.
#
# 48000 rather than 44100 is deliberate. usb_device_uac drains the USB FIFO
# by spk_bytes_per_ms = rate / 1000 * channels * bytes, an integer division
# that truncates 44.1 frames/ms to 44. Because the feedback endpoint uses
# AUDIO_FEEDBACK_METHOD_FIFO_COUNT, that FIFO is the control variable, so the
# host is held at 44000 frames/s while I2S consumes 44100 — a ~100 frames/s
# deficit that drains the ring buffer and then glitches continuously.
# 48000 divides into 1 ms frames exactly, so the loop settles correctly.
CONFIG_OUTPUT_SAMPLE_RATE_48000=y
CONFIG_UAC_SAMPLE_RATE=48000

# usb_device_uac reads each 1 ms packet into a single buffer from the USB
# interrupt and wakes its speaker task to hand it on, so a packet that comes
# before the task has run overwrites the one before it. At the default
# priority of 5 the task shared its level with the web server, which could
# hold it off for a whole 10 ms tick while serving a page. 15 is the most the
# component allows. Core 1 keeps the task clear of the Wi-Fi task (23), which
# is pinned to core 0, and lwIP (18), free until now to run on either core,
# is pinned there beside it.
CONFIG_UAC_SPK_TASK_PRIORITY=15
CONFIG_UAC_SPK_TASK_CORE=1
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y

# Build UAC as one function of a composite device so main/usb can add an HID
# consumer-control interface (media keys back to the host). This makes
# usb_device_uac withhold its own descriptors, tusb_config.h and
# VID/PID/string/RHPORT options — CONFIG_USB_AUDIO_SINK_* replace the strings
# and the root port defaults to full speed.
CONFIG_USB_DEVICE_UAC_AS_PART=y
CONFIG_USB_AUDIO_SINK_MANUFACTURER="Espressif"
CONFIG_USB_AUDIO_SINK_PRODUCT="ESP32 Audio Device"

# macOS and Windows want the rate feedback in different formats; main/usb
# guesses the host and picks one. Enable this to force macOS's format for
# every host if the guess is ever wrong.
# CONFIG_UAC_SUPPORT_MACOS=y

# TinyUSB claims the USB PHY, so USB-Serial-JTAG cannot also be a console.
# Logs stay on UART0; hold BOOT while resetting to reflash over USB.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
