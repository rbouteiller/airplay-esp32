CONFIG_BOARD_ESP32S31_GENERIC=y

# Flash layout (8 MB)
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_200M=y

# Enable software EQ
CONFIG_SOFTWARE_EQ=y

# GPIO defaults
CONFIG_LED_RGB_GPIO=60
CONFIG_I2S_SCK_IO=2
CONFIG_I2S_BCK_IO=3
CONFIG_I2S_WS_IO=4
CONFIG_I2S_DO_IO=5
