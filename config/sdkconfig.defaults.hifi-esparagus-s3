# HiFi-Esparagus-S3 defaults (ESP32-S3, PCM5100 — plain I2S DAC, no I2C, no mute pin)
CONFIG_BOARD_HIFI_ESPARAGUS_S3=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_SPIRAM_MODE_OCT=y

# GPIO config
CONFIG_I2S_SCK_IO=-1
CONFIG_I2S_BCK_IO=14
CONFIG_I2S_WS_IO=15
CONFIG_I2S_DO_IO=16
CONFIG_LED_RGB_GPIO=9
