# HiFi-ESP32-Plus defaults (ESP32 rev J1+, PCM5122 — I2C-controlled DAC run
# from BCK, DAC/AMP enable on GPIO 13). Rev J wires SDA/SCL the other way
# round; this file describes rev J1 and later only.
CONFIG_BOARD_HIFI_ESP32_PLUS=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_DAC_PCM51XX=y
CONFIG_DAC_CONTROLS_VOLUME=y
CONFIG_PCM51XX_I2C_ADDR=0x4D

# GPIO config
CONFIG_I2S_BCK_IO=26
CONFIG_I2S_WS_IO=25
CONFIG_I2S_DO_IO=22
CONFIG_DAC_I2C_SDA=21
CONFIG_DAC_I2C_SCL=27
CONFIG_DAC_ENABLE_GPIO=13

# No status LED: the WS2812 on GPIO 12 is not fitted by default. Set
# CONFIG_LED_RGB_GPIO=12 on a board that has one.

# W5500 Ethernet
CONFIG_ETH_W5500_ENABLED=y
CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_W5500=y
CONFIG_SPI_CLK_GPIO=18
CONFIG_SPI_MOSI_GPIO=23
CONFIG_SPI_MISO_GPIO=19
CONFIG_ETH_W5500_CS_GPIO=5
CONFIG_ETH_W5500_INT_GPIO=35
CONFIG_ETH_W5500_RST_GPIO=14

# SPI Display
CONFIG_DISPLAY_ENABLED=y
CONFIG_DISPLAY_DRIVER_SH1106=y
CONFIG_DISPLAY_BUS_SPI=y
CONFIG_DISPLAY_SPI_CLK=18
CONFIG_DISPLAY_SPI_MOSI=23
CONFIG_DISPLAY_SPI_CS=15
CONFIG_DISPLAY_SPI_DC=4
CONFIG_DISPLAY_SPI_RST=32
