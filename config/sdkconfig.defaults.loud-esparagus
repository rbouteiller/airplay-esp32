# Loud-Esparagus defaults (ESP32, dual MAX98357A — I2S amp, active-high
# SD_MODE enable, no I2C, no Ethernet/display)
CONFIG_BOARD_LOUD_ESPARAGUS=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

# GPIO config
CONFIG_I2S_BCK_IO=26
CONFIG_I2S_WS_IO=25
CONFIG_I2S_DO_IO=22
CONFIG_DAC_ENABLE_GPIO=13
CONFIG_LED_RGB_GPIO=33
