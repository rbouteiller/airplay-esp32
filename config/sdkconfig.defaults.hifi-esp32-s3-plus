# HiFi-ESP32-S3-Plus defaults (ESP32-S3 rev H1+, PCM5122 — I2C-controlled DAC
# run from BCK, XSMT on GPIO 4). The HiFi-ESP32-S3's pins throughout, with the
# DAC's I2C bus added. Rev H wires SDA/SCL the other way round and answers at
# 0x4C; this file describes rev H1 and later only.
CONFIG_BOARD_HIFI_ESP32_S3_PLUS=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_DAC_PCM51XX=y
CONFIG_DAC_CONTROLS_VOLUME=y
CONFIG_PCM51XX_I2C_ADDR=0x4D

# GPIO config
CONFIG_I2S_SCK_IO=-1
CONFIG_I2S_BCK_IO=14
CONFIG_I2S_WS_IO=15
CONFIG_I2S_DO_IO=16
CONFIG_DAC_I2C_SDA=42
CONFIG_DAC_I2C_SCL=41
CONFIG_DAC_ENABLE_GPIO=4
CONFIG_LED_RGB_GPIO=-1

# W5500 Ethernet
CONFIG_ETH_W5500_ENABLED=y
CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_W5500=y
CONFIG_SPI_CLK_GPIO=12
CONFIG_SPI_MOSI_GPIO=11
CONFIG_SPI_MISO_GPIO=13
CONFIG_ETH_W5500_CS_GPIO=10
CONFIG_ETH_W5500_INT_GPIO=6
CONFIG_ETH_W5500_RST_GPIO=5

# SPI Display
CONFIG_DISPLAY_ENABLED=y
CONFIG_DISPLAY_DRIVER_SH1106=y
CONFIG_DISPLAY_BUS_SPI=y
CONFIG_DISPLAY_SPI_CLK=12
CONFIG_DISPLAY_SPI_MOSI=11
CONFIG_DISPLAY_SPI_CS=39
CONFIG_DISPLAY_SPI_DC=40
CONFIG_DISPLAY_SPI_RST=38
