# Esparagus-Echo defaults (ESP32-S3, dual MAX98357A — I2S amp, active-high
# SD_MODE enable, no I2C; Ethernet, no display)
CONFIG_BOARD_ESPARAGUS_ECHO=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_SPIRAM_MODE_OCT=y

# GPIO config
CONFIG_I2S_SCK_IO=-1
CONFIG_I2S_BCK_IO=18
CONFIG_I2S_WS_IO=8
CONFIG_I2S_DO_IO=17
CONFIG_DAC_ENABLE_GPIO=9
CONFIG_LED_RGB_GPIO=42

# W5500 Ethernet
CONFIG_ETH_W5500_ENABLED=y
CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_W5500=y
CONFIG_SPI_CLK_GPIO=12
CONFIG_SPI_MOSI_GPIO=11
CONFIG_SPI_MISO_GPIO=13
CONFIG_ETH_W5500_CS_GPIO=10
CONFIG_ETH_W5500_INT_GPIO=6
CONFIG_ETH_W5500_RST_GPIO=5
