# Software parametric EQ (the /bq page) for plain I2S DACs and amplifiers
# without a DSP of their own, such as the PCM5102A or MAX98357A.
# Layer on top of a board's defaults, e.g.
#   idf.py -DSDKCONFIG_DEFAULTS="config/sdkconfig.defaults;config/sdkconfig.defaults.esp32s3;config/sdkconfig.defaults.software-eq" build
#
# Needs a chip with an FPU (ESP32, ESP32-S3, ESP32-P4), and is ignored on
# boards with a TAS57xx or TAS58xx, whose own DSP backs the page instead.

CONFIG_SOFTWARE_EQ=y
